{
  "name": "@regino/crypto",
  "version": "0.15.1",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "vitest run --coverage",
    "check": "tsc --noEmit",
    "build:tool": "node tools/build.mjs",
    "bench": "esbuild bench/chain.ts --bundle --platform=node --format=esm --outfile=bench/.out/chain.mjs --log-level=warning && node bench/.out/chain.mjs",
    "bench:code": "esbuild bench/backupCode.ts --bundle --platform=node --format=esm --outfile=bench/.out/backupCode.mjs --log-level=warning && node bench/.out/backupCode.mjs"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "7.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "qrcode-generator": "2.0.4"
  }
}
